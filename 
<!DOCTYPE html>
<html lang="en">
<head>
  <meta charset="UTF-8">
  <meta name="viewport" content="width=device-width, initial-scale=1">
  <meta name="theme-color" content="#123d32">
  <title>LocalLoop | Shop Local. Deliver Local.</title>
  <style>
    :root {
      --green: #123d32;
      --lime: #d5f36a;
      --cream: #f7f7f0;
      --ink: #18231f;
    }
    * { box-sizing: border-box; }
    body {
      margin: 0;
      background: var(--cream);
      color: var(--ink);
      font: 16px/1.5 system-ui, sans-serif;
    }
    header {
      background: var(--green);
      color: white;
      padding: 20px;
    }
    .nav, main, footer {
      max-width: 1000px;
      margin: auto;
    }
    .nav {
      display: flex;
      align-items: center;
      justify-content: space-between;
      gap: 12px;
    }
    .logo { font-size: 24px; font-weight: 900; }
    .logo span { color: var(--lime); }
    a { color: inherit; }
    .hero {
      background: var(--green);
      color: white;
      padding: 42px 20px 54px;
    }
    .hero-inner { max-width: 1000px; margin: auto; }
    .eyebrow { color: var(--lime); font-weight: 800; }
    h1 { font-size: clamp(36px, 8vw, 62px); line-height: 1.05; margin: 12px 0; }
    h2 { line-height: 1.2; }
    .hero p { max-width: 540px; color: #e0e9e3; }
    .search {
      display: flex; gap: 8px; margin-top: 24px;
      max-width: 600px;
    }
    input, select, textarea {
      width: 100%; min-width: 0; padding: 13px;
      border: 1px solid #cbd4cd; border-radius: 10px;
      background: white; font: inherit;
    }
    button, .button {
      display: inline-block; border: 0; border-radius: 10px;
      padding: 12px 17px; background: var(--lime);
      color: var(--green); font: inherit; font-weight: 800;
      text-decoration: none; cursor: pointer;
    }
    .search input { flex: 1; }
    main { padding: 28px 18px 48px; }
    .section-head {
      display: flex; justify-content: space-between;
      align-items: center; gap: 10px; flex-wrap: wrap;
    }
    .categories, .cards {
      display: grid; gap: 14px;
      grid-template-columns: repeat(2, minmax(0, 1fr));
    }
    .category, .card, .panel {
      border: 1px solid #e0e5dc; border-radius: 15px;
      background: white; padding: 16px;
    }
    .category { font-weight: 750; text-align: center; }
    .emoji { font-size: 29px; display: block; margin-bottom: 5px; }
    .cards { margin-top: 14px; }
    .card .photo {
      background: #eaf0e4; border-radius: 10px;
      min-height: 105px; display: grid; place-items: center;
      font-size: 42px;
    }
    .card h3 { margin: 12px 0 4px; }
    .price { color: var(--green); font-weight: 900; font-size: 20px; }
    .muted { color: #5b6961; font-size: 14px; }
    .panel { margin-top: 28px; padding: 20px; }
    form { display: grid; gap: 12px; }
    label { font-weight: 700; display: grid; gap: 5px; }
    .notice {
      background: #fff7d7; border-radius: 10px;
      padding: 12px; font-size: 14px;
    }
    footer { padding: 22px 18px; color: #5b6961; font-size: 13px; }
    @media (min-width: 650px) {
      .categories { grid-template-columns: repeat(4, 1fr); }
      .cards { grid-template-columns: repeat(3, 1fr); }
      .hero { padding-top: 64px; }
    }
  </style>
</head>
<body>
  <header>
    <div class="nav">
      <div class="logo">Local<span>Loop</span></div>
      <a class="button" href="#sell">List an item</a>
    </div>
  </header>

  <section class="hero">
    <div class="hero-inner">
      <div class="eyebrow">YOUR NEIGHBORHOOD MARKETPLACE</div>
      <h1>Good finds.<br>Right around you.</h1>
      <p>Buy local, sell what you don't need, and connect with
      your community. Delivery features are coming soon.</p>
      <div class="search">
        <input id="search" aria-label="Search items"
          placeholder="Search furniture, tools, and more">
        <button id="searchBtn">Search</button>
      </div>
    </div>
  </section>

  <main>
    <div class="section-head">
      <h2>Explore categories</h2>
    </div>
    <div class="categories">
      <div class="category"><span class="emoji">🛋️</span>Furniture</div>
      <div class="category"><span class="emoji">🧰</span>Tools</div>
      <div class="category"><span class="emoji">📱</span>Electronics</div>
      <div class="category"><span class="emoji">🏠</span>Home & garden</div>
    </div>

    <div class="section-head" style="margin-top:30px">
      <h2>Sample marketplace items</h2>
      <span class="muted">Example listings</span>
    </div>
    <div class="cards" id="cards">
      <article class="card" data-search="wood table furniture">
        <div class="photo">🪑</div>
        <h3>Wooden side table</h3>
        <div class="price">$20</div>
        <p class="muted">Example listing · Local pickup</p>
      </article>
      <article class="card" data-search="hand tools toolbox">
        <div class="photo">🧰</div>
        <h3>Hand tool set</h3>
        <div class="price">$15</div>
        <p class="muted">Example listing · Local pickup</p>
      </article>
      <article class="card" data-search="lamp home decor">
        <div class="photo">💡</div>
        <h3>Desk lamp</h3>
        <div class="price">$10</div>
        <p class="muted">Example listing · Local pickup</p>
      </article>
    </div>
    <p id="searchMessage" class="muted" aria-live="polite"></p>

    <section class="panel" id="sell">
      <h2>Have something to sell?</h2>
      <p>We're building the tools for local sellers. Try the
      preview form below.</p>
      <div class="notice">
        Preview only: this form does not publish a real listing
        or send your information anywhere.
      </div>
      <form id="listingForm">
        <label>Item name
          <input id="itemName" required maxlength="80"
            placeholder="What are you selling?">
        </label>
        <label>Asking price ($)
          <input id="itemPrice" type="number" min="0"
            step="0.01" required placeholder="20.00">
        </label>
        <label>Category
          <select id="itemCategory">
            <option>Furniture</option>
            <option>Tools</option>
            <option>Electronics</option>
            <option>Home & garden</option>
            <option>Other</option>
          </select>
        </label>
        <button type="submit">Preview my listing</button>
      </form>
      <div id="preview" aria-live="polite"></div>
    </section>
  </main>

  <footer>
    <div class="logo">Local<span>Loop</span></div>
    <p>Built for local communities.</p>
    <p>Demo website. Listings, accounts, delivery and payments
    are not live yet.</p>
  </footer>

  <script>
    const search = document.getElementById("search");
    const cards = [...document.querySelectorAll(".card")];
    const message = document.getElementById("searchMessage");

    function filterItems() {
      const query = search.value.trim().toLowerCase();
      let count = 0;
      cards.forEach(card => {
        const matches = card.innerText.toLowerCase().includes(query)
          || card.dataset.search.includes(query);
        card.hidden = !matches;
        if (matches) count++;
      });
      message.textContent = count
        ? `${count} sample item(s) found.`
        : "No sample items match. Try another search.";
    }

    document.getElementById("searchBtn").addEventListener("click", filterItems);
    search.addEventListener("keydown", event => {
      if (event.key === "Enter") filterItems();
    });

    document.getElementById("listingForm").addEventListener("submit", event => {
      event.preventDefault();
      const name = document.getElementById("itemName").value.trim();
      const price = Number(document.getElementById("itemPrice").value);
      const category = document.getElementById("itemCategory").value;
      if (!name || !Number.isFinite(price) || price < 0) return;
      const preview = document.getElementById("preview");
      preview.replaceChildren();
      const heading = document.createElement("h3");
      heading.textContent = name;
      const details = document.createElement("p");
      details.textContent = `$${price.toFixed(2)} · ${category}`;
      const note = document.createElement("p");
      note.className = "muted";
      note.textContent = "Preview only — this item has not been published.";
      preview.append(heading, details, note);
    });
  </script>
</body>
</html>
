
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#123d32">
  <title>LocalLoop | Shop Local. Deliver Local.</title>
  <style>
    :root {
      --green: #123d32;
      --lime: #d5f36a;
      --cream: #f7f7f0;
      --ink: #18231f;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--cream);
      color: var(--ink);
      font: 16px/1.5 system-ui, sans-serif;
    }
    header {
      background: var(--green);
      color: white;
      padding: 20px;
    }
    .nav, main, footer {
      max-width: 1000px;
      margin: auto;
    }
    .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .logo { font-size: 24px; font-weight: 900; }
    .logo span { color: var(--lime); }
    a { color: inherit; }
    .hero {
      background: var(--green);
      color: white;
      padding: 42px 20px 54px;
    }
    .hero-inner { max-width: 1000px; margin: auto; }
    .eyebrow { color: var(--lime); font-weight: 800; }
    h1 { font-size: clamp(36px, 8vw, 62px); line-height: 1.05; margin: 12px 0; }
    h2 { line-height: 1.2; }
    .hero p { max-width: 540px; color: #e0e9e3; }
    .search {
      display: flex; gap: 8px; margin-top: 24px;
      max-width: 600px;
    }
    input, select, textarea {
      width: 100%; min-width: 0; padding: 13px;
      border: 1px solid #cbd4cd; border-radius: 10px;
      background: white; font: inherit;
    }
    button, .button {
      display: inline-block; border: 0; border-radius: 10px;
      padding: 12px 17px; background: var(--lime);
      color: var(--green); font: inherit; font-weight: 800;
      text-decoration: none; cursor: pointer;
    }
    .search input { flex: 1; }
    main { padding: 28px 18px 48px; }
    .section-head {
      display: flex; justify-content: space-between;
      align-items: center; gap: 10px; flex-wrap: wrap;
    }
    .categories, .cards {
      display: grid; gap: 14px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .category, .card, .panel {
      border: 1px solid #e0e5dc; border-radius: 15px;
      background: white; padding: 16px;
    }
    .category { font-weight: 750; text-align: center; }
    .emoji { font-size: 29px; display: block; margin-bottom: 5px; }
    .cards { margin-top: 14px; }
    .card .photo {
      background: #eaf0e4; border-radius: 10px;
      min-height: 105px; display: grid; place-items: center;
      font-size: 42px;
    }
    .card h3 { margin: 12px 0 4px; }
    .price { color: var(--green); font-weight: 900; font-size: 20px; }
    .muted { color: #5b6961; font-size: 14px; }
    .panel { margin-top: 28px; padding: 20px; }
    form { display: grid; gap: 12px; }
    label { font-weight: 700; display: grid; gap: 5px; }
    .notice {
      background: #fff7d7; border-radius: 10px;
      padding: 12px; font-size: 14px;
    }
    footer { padding: 22px 18px; color: #5b6961; font-size: 13px; }
    @media (min-width: 650px) {
      .categories { grid-template-columns: repeat(4, 1fr); }
      .cards { grid-template-columns: repeat(3, 1fr); }
      .hero { padding-top: 64px; }
    }
  </style>
</head>
<body>
  <header>
    <div class="nav">
      <div class="logo">Local<span>Loop</span></div>
      <a class="button" href="#sell">List an item</a>
    </div>
  </header>

  <section class="hero">
    <div class="hero-inner">
      <div class="eyebrow">YOUR NEIGHBORHOOD MARKETPLACE</div>
      <h1>Good finds.<br>Right around you.</h1>
      <p>Buy local, sell what you don't need, and connect with
      your community. Delivery features are coming soon.</p>
      <div class="search">
        <input id="search" aria-label="Search items"
          placeholder="Search furniture, tools, and more">
        <button id="searchBtn">Search</button>
      </div>
    </div>
  </section>

  <main>
    <div class="section-head">
      <h2>Explore categories</h2>
    </div>
    <div class="categories">
      <div class="category"><span class="emoji">🛋️</span>Furniture</div>
      <div class="category"><span class="emoji">🧰</span>Tools</div>
      <div class="category"><span class="emoji">📱</span>Electronics</div>
      <div class="category"><span class="emoji">🏠</span>Home & garden</div>
    </div>

    <div class="section-head" style="margin-top:30px">
      <h2>Sample marketplace items</h2>
      <span class="muted">Example listings</span>
    </div>
    <div class="cards" id="cards">
      <article class="card" data-search="wood table furniture">
        <div class="photo">🪑</div>
        <h3>Wooden side table</h3>
        <div class="price">$20</div>
        <p class="muted">Example listing · Local pickup</p>
      </article>
      <article class="card" data-search="hand tools toolbox">
        <div class="photo">🧰</div>
        <h3>Hand tool set</h3>
        <div class="price">$15</div>
        <p class="muted">Example listing · Local pickup</p>
      </article>
      <article class="card" data-search="lamp home decor">
        <div class="photo">💡</div>
        <h3>Desk lamp</h3>
        <div class="price">$10</div>
        <p class="muted">Example listing · Local pickup</p>
      </article>
    </div>
    <p id="searchMessage" class="muted" aria-live="polite"></p>

    <section class="panel" id="sell">
      <h2>Have something to sell?</h2>
      <p>We're building the tools for local sellers. Try the
      preview form below.</p>
      <div class="notice">
        Preview only: this form does not publish a real listing
        or send your information anywhere.
      </div>
      <form id="listingForm">
        <label>Item name
          <input id="itemName" required maxlength="80"
            placeholder="What are you selling?">
        </label>
        <label>Asking price ($)
          <input id="itemPrice" type="number" min="0"
            step="0.01" required placeholder="20.00">
        </label>
        <label>Category
          <select id="itemCategory">
            <option>Furniture</option>
            <option>Tools</option>
            <option>Electronics</option>
            <option>Home & garden</option>
            <option>Other</option>
          </select>
        </label>
        <button type="submit">Preview my listing</button>
      </form>
      <div id="preview" aria-live="polite"></div>
    </section>
  </main>

  <footer>
    <div class="logo">Local<span>Loop</span></div>
    <p>Built for local communities.</p>
    <p>Demo website. Listings, accounts, delivery and payments
    are not live yet.</p>
  </footer>

  <script>
    const search = document.getElementById("search");
    const cards = [...document.querySelectorAll(".card")];
    const message = document.getElementById("searchMessage");

    function filterItems() {
      const query = search.value.trim().toLowerCase();
      let count = 0;
      cards.forEach(card => {
        const matches = card.innerText.toLowerCase().includes(query)
          || card.dataset.search.includes(query);
        card.hidden = !matches;
        if (matches) count++;
      });
      message.textContent = count
        ? `${count} sample item(s) found.`
        : "No sample items match. Try another search.";
    }

    document.getElementById("searchBtn").addEventListener("click", filterItems);
    search.addEventListener("keydown", event => {
      if (event.key === "Enter") filterItems();
    });

    document.getElementById("listingForm").addEventListener("submit", event => {
      event.preventDefault();
      const name = document.getElementById("itemName").value.trim();
      const price = Number(document.getElementById("itemPrice").value);
      const category = document.getElementById("itemCategory").value;
      if (!name || !Number.isFinite(price) || price < 0) return;
      const preview = document.getElementById("preview");
      preview.replaceChildren();
      const heading = document.createElement("h3");
      heading.textContent = name;
      const details = document.createElement("p");
      details.textContent = `$${price.toFixed(2)} · ${category}`;
      const note = document.createElement("p");
      note.className = "muted";
      note.textContent = "Preview only — this item has not been published.";
      preview.append(heading, details, note);
    });
  </script>
</body>
</html>
